# Google Cloud must allow http://localhost:8082 and your deployed dashboard origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Server-only, comma-separated Google email addresses. Empty denies everyone.
STAFF_EMAILS=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use a separate random secret for each environment; at least 32 bytes.
STAFF_SESSION_SECRET=
